{
  "name": "server-tool",
  "version": "1.0.0",
  "description": "Linux server connection tool with SSH and SFTP",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.11.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "element-plus": "^2.5.0",
    "pinia": "^2.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.servertoll.app",
    "productName": "ServerTool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {}
}
